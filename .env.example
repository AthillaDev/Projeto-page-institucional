# Copie para .env.local e preencha.

# WhatsApp que recebe candidaturas (código do país + DDD + número, somente dígitos).
# Usado como fallback quando o envio pelo formulário falha. Ex.: 5521999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Destino das candidaturas (Zapier, Make, n8n, Google Sheets via Apps Script, CRM etc.).
# O endpoint faz POST com JSON: nome, e-mail, whatsapp, cargo e o registro de consentimento.
# Sem esta variável, o formulário mostra o fallback do WhatsApp.
LEADS_WEBHOOK_URL=

# Sal opcional usado no hash do IP guardado no registro de consentimento.
LEADS_IP_SALT=
